model user_sanctuary_items {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sanctuary_id        String              @db.Uuid
  sanctuary_item_id   String              @db.Uuid
  position            Json?
  rotation            Json?
  scale               Json?
  equipped            Boolean             @default(true)
  created_at          DateTime            @default(now()) @db.Timestamptz(6)
  virtual_sanctuaries virtual_sanctuaries @relation(fields: [sanctuary_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sanctuary_items     sanctuary_items     @relation(fields: [sanctuary_item_id], references: [id], onUpdate: NoAction)
}

model user_settings {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String   @unique @db.Uuid
  locale              String   @default("vi") @db.VarChar(20)
  theme               String   @default("dark") @db.VarChar(30)
  email_notifications Boolean  @default(true)
  push_notifications  Boolean  @default(true)
  updated_at          DateTime @default(now()) @db.Timestamptz(6)
  users               users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model user_topics {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  topic      String   @db.VarChar(100)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, topic])
}

model users {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  full_name            String                 @db.VarChar(120)
  email                String                 @unique @db.VarChar(255)
  password_hash        String
  avatar_url           String?
  role                 user_role              @default(USER)
  status               account_status         @default(ACTIVE)
  date_of_birth        DateTime?              @db.Date
  gender               String?                @db.VarChar(30)
  phone                String?                @db.VarChar(30)
  bio                  String?
  last_login_at        DateTime?              @db.Timestamptz(6)
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @default(now()) @db.Timestamptz(6)
  ai_generation_logs   ai_generation_logs[]
  astrology_profiles   astrology_profiles[]
  calendar_notes       calendar_notes[]
  family_members       family_members[]
  family_trees         family_trees[]
  favorites            favorites[]
  file_assets          file_assets[]
  horoscope_readings   horoscope_readings[]
  incense_sessions     incense_sessions[]
  memorials            memorials[]
  mood_checkins        mood_checkins[]
  notifications        notifications[]
  physiognomy_analyses physiognomy_analyses[]
  refresh_tokens       refresh_tokens[]
  reminders            reminders[]
  subscriptions        subscriptions[]
  payment_orders       payment_orders[]
  push_subscriptions   push_subscriptions[]
  analytics_events     analytics_events[]
  admin_audit_logs     admin_audit_logs[]
  user_divinations     user_divinations[]
  user_settings        user_settings?
  user_topics          user_topics[]
  virtual_sanctuaries  virtual_sanctuaries?
  wishes               wishes[]
  xin_keo_sessions     xin_keo_sessions[]
  xin_xam_draws        xin_xam_draws[]

  @@index([email], map: "idx_users_email")
  @@index([role], map: "idx_users_role")
}

model push_subscriptions {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  endpoint   String   @unique
  p256dh     String
  auth       String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@index([user_id])
}

model payment_orders {
  id             String    @id @db.VarChar(32)
  user_id        String    @db.Uuid
  plan_id        String    @db.Uuid
  amount         Int
  status         String    @default("PENDING") @db.VarChar(16)
  transaction_no String?   @unique @db.VarChar(30)
  response_code  String?   @db.VarChar(10)
  expires_at     DateTime  @db.Timestamptz(6)
  paid_at        DateTime? @db.Timestamptz(6)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  users          users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  membership_plans membership_plans @relation(fields: [plan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id, created_at])
}

model admin_audit_logs {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor_id    String   @db.Uuid
  action      String   @db.VarChar(80)
  target_type String   @db.VarChar(50)
  target_id   String   @db.Uuid
  details     Json     @default("{}")
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  users       users    @relation(fields: [actor_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([created_at(sort: Desc)], map: "idx_admin_audit_logs_created")
  @@index([target_type, target_id], map: "idx_admin_audit_logs_target")
}

model analytics_events {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  client_event_id String  @unique @db.Uuid
  user_id        String?  @db.Uuid
  anonymous_id   String   @db.Uuid
  event_name     String   @db.VarChar(64)
  campaign_source String? @db.VarChar(32)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  users          users?   @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([event_name, created_at], map: "idx_analytics_events_name_created")
  @@index([user_id, created_at], map: "idx_analytics_events_user_created")
  @@index([anonymous_id, created_at], map: "idx_analytics_events_anon_created")
}

model virtual_sanctuaries {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id              String                 @unique @db.Uuid
  name                 String                 @default("Góc tri ân") @db.VarChar(255)
  theme                String?                @default("MIEN_TAY") @db.VarChar(100)
  region               vietnam_region?        @default(SOUTH)
  background_asset_url String?
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @default(now()) @db.Timestamptz(6)
  incense_sessions     incense_sessions[]
  user_sanctuary_items user_sanctuary_items[]
  users                users                  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model wishes {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String             @db.Uuid
  title         String?            @db.VarChar(255)
  content       String
  category      String?            @db.VarChar(100)
  visibility    visibility_type    @default(PRIVATE)
  delivery_type wish_delivery_type @default(VOID)
  is_sealed     Boolean            @default(true)
  starred       Boolean            @default(false)
  released_at   DateTime?          @db.Timestamptz(6)
  created_at    DateTime           @default(now()) @db.Timestamptz(6)
  updated_at    DateTime           @default(now()) @db.Timestamptz(6)
  users         users              @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_wishes_user_id")
}

model xin_keo_sessions {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String           @db.Uuid
  question       String
  final_result   xin_keo_result?
  ai_explanation String?
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  users          users            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  xin_keo_throws xin_keo_throws[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model xin_keo_throws {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id       String           @db.Uuid
  throw_number     Int              @db.SmallInt
  left_side        String           @db.VarChar(20)
  right_side       String           @db.VarChar(20)
  result           xin_keo_result
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  proverb_id       String?          @db.Uuid
  proverbs         proverbs?        @relation(fields: [proverb_id], references: [id], onUpdate: NoAction)
  xin_keo_sessions xin_keo_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([session_id, throw_number])
  @@index([proverb_id], map: "idx_xin_keo_throws_proverb_id")
}

model xin_xam {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stick_number  Int
  name          String?         @db.VarChar(255)
  xam_type      String          @db.VarChar(100)
  region        vietnam_region  @default(NATIONWIDE)
  category      String?         @db.VarChar(100)
  fortune_level String?         @db.VarChar(80)
  poem          String?
  meaning       String?
  advice        String?
  source        String?
  verified      Boolean         @default(false)
  active        Boolean         @default(true)
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  updated_at    DateTime        @default(now()) @db.Timestamptz(6)
  xin_xam_draws xin_xam_draws[]

  @@unique([xam_type, stick_number])
  @@index([xam_type], map: "idx_xin_xam_type")
}

model xin_xam_draws {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String    @db.Uuid
  xin_xam_id     String    @db.Uuid
  question       String?
  ai_explanation String?
  starred        Boolean   @default(false)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  proverb_id     String?   @db.Uuid
  proverbs       proverbs? @relation(fields: [proverb_id], references: [id], onUpdate: NoAction)
  users          users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  xin_xam        xin_xam   @relation(fields: [xin_xam_id], references: [id], onUpdate: NoAction)

  @@index([user_id], map: "idx_xin_xam_draws_user_id")
  @@index([proverb_id], map: "idx_xin_xam_draws_proverb_id")
}

