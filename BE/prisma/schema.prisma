generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ai_generation_logs {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String?  @db.Uuid
  feature         String   @db.VarChar(100)
  model           String?  @db.VarChar(100)
  prompt_version  String?  @db.VarChar(100)
  input_snapshot  Json?
  output_snapshot Json?
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  users           users?   @relation(fields: [user_id], references: [id], onUpdate: NoAction)
}

model astrology_analyses {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chart_id         String           @db.Uuid
  analysis_type    String           @db.VarChar(100)
  input_snapshot   Json?
  content          String
  model            String?          @db.VarChar(100)
  prompt_version   String?          @db.VarChar(100)
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  astrology_charts astrology_charts @relation(fields: [chart_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model astrology_charts {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profile_id         String               @db.Uuid
  year_stem          String?              @db.VarChar(50)
  year_branch        String?              @db.VarChar(50)
  element            String?              @db.VarChar(100)
  destiny_palace     String?              @db.VarChar(100)
  chart_data         Json                 @default("{}")
  algorithm_version  String?              @db.VarChar(50)
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  astrology_analyses astrology_analyses[]
  astrology_profiles astrology_profiles   @relation(fields: [profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model astrology_profiles {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String               @db.Uuid
  full_name          String               @db.VarChar(255)
  birth_date         DateTime             @db.Date
  birth_time         DateTime?            @db.Time(6)
  gender             String?              @db.VarChar(30)
  birth_place        String?              @db.VarChar(255)
  lunar_date         DateTime?            @db.Date
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @default(now()) @db.Timestamptz(6)
  astrology_charts   astrology_charts[]
  users              users                @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  horoscope_readings horoscope_readings[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model calendar_events {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title          String           @db.VarChar(255)
  description    String?
  calendar       calendar_type    @default(LUNAR)
  day            Int?             @db.SmallInt
  month          Int?             @db.SmallInt
  region         vietnam_region?  @default(NATIONWIDE)
  category       String?          @db.VarChar(100)
  source         String?
  verified       Boolean          @default(false)
  active         Boolean          @default(true)
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  calendar_notes calendar_notes[]
}

model calendar_notes {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String           @db.Uuid
  event_id        String?          @db.Uuid
  title           String           @db.VarChar(255)
  note            String?
  event_date      DateTime         @db.Date
  calendar        calendar_type    @default(SOLAR)
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  updated_at      DateTime         @default(now()) @db.Timestamptz(6)
  calendar_events calendar_events? @relation(fields: [event_id], references: [id], onUpdate: NoAction)
  users           users            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model culture_articles {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug       String          @unique @db.VarChar(255)
  title      String          @db.VarChar(255)
  excerpt    String?
  category   String?         @db.VarChar(120)
  region     vietnam_region? @default(NATIONWIDE)
  image_url  String?
  content    Json
  source     String?
  verified   Boolean         @default(false)
  active     Boolean         @default(true)
  created_at DateTime        @default(now()) @db.Timestamptz(6)
  updated_at DateTime        @default(now()) @db.Timestamptz(6)

  @@index([category])
  @@index([region])
}

model divination_results {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  divination_type_id String             @db.Uuid
  result_code        String             @db.VarChar(100)
  title              String?            @db.VarChar(255)
  content            String
  meaning            String?
  advice             String?
  source             String?
  verified           Boolean            @default(false)
  active             Boolean            @default(true)
  created_at         DateTime           @default(now()) @db.Timestamptz(6)
  divination_types   divination_types   @relation(fields: [divination_type_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_divinations   user_divinations[]

  @@unique([divination_type_id, result_code])
}

model divination_types {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code               String               @unique @db.VarChar(80)
  name               String               @db.VarChar(255)
  description        String?
  region             vietnam_region?      @default(NATIONWIDE)
  active             Boolean              @default(true)
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  divination_results divination_results[]
  user_divinations   user_divinations[]
}

model family_members {
  id                                                                       String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  family_tree_id                                                           String                 @db.Uuid
  linked_user_id                                                           String?                @db.Uuid
  full_name                                                                String                 @db.VarChar(255)
  gender                                                                   String?                @db.VarChar(30)
  birth_date                                                               DateTime?              @db.Date
  death_date                                                               DateTime?              @db.Date
  avatar_url                                                               String?
  biography                                                                String?
  created_at                                                               DateTime               @default(now()) @db.Timestamptz(6)
  updated_at                                                               DateTime               @default(now()) @db.Timestamptz(6)
  family_trees                                                             family_trees           @relation(fields: [family_tree_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                                                                    users?                 @relation(fields: [linked_user_id], references: [id], onUpdate: NoAction)
  family_relationships_family_relationships_from_member_idTofamily_members family_relationships[] @relation("family_relationships_from_member_idTofamily_members")
  family_relationships_family_relationships_to_member_idTofamily_members   family_relationships[] @relation("family_relationships_to_member_idTofamily_members")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model family_relationships {
  id                                                                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  family_tree_id                                                     String         @db.Uuid
  from_member_id                                                     String         @db.Uuid
  to_member_id                                                       String         @db.Uuid
  relation                                                           relation_type
  created_at                                                         DateTime       @default(now()) @db.Timestamptz(6)
  family_trees                                                       family_trees   @relation(fields: [family_tree_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  family_members_family_relationships_from_member_idTofamily_members family_members @relation("family_relationships_from_member_idTofamily_members", fields: [from_member_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  family_members_family_relationships_to_member_idTofamily_members   family_members @relation("family_relationships_to_member_idTofamily_members", fields: [to_member_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([from_member_id, to_member_id, relation])
}

model family_trees {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_user_id        String                 @db.Uuid
  name                 String                 @db.VarChar(255)
  description          String?
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @default(now()) @db.Timestamptz(6)
  family_members       family_members[]
  family_relationships family_relationships[]
  users                users                  @relation(fields: [owner_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model favorites {
